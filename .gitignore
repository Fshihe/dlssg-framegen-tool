# 构建产物
dist/
work/
build/
*.spec

# 上游代理 DLL —— 不入库，用 tools/fetch_payload.py 从上游获取
# （这样仓库本身不再分发这些二进制，来源也更清楚）
payload/**/*.dll
payload/*.dll

# OptiScaler 引擎包 —— 同样不入库，用 tools/fetch_optiscaler.py 从本地压缩包提取。
# 整目录排除：里面除了 DLL 还有配置模板和第三方许可文件，都不该进仓库。
# 理由：OptiScaler 是 GPLv3，Intel XeSS SDK 的许可禁止逆向与运行时修改，
# 而 DLSS 5 那份 nvngx_dlssnr.dll 更是未签名的预览版组件 —— 由使用者自行获取。
payload/optiscaler-xess/
payload/optiscaler-dlss5/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本地杂项
*.log
诊断包-*.txt
